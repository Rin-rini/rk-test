{
  "name": "dashboard-ui-test",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "dev:legacy": "vite --config vite.legacy.config.ts",
    "build:legacy": "tsc -b && vite build --config vite.legacy.config.ts",
    "preview:legacy": "vite preview --config vite.legacy.config.ts",
    "dev:check": "vite --config vite.check.config.ts",
    "build:check": "tsc -b && vite build --config vite.check.config.ts",
    "preview:check": "vite preview --config vite.check.config.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "framer-motion": "^14.14.0",
    "lucide-react": "^1.79.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.11.1"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "storybook": "^10.6.8",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.2"
  }
}
